# Leave empty in local dev so Vite proxies /api → http://localhost:8000 (recommended).
# Local: leave empty to use Vite proxy to :8000, or set explicitly:
# VITE_API_URL=http://localhost:8000
# Vercel preview: set to your public API (no trailing slash), e.g. https://api.example.com
VITE_API_URL=
# Optional fallback if /api/v1/support/info has no policies_bot_url
VITE_POLICIES_BOT_URL=

# --- Stabilisation: all new clinical UI is explicit opt-in (default = legacy stable paths) ---
# VITE_APP_ENV=staging
# VITE_ENABLE_REPORTS=true
# VITE_ENABLE_REPORT_BUILDER=true
# VITE_REPORTS_REVAMP=true
# VITE_CASE_REPORTS_TAB_V2=true
# VITE_MONTHLY_REPORTS_USE_CLINICAL_ENGINE=true
# VITE_STRUCTURED_SESSION_EVIDENCE=true
# VITE_GOALS_STRATEGIES_ENGINE_V2=true
# VITE_ENABLE_CLINICAL_BRAIN=true
