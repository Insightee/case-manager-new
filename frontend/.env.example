# Leave empty in local dev so Vite proxies /api → http://localhost:8000 (recommended).
# Local: leave empty to use Vite proxy to :8000, or set explicitly:
# VITE_API_URL=http://localhost:8000
# Vercel preview: set to your public API (no trailing slash), e.g. https://api.example.com
VITE_API_URL=
# Optional fallback if /api/v1/support/info has no policies_bot_url
VITE_POLICIES_BOT_URL=
# Temporary: hide leave credits + paid/unpaid from therapists during leave migration (default on).
# Set to false to restore the full therapist leave UI after migration.
# VITE_HIDE_THERAPIST_LEAVE_CREDITS_UI=false

# Stage 1 Finance Control Tower (forced off on canonical production)
# VITE_ENABLE_FINANCE_DASHBOARD_V1=false
# Client billing visibility (parent Payments + therapist Invoices). Forced off on canonical production.
# Prefer VITE_ENABLE_CLIENT_BILLING; legacy VITE_ENABLE_BILLING still accepted for one release.
# VITE_ENABLE_CLIENT_BILLING=false
# VITE_ENABLE_BILLING=false
# IEP goal/strategy taps on the session log form (default off; also requires backend ENABLE_STRUCTURED_EVIDENCE)
# VITE_ENABLE_STRUCTURED_EVIDENCE=false
