# Copy to Vercel → Environment Variables. Do not use backend/.env.example.

# --- Production (insighte.org) ---
# VITE_API_URL=https://case-manager-new-production.up.railway.app
# VITE_APP_ENV=production
# Do NOT set VITE_ENABLE_REPORTS / VITE_ENABLE_BILLING on Production — UI forces Coming Soon.

# --- Staging / Preview (branch deploys, e.g. staging/stabilisation-pre-reports) ---
# VITE_API_URL=https://case-manager-new-production.up.railway.app
# VITE_APP_ENV=staging
# VITE_ENABLE_REPORTS=true
# VITE_ENABLE_BILLING=true
