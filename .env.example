# Local secrets — copy to `.env` in the repo root (gitignored). Do not commit filled values.

# Google Stitch MCP (Cursor IDE). Required for `.cursor/mcp.json` header interpolation.
# Create a key in Google Stitch / Google Cloud, then:
#   export STITCH_GOOG_API_KEY="your-key"
# Cursor remote MCP reads process environment, not this file, unless you export it
# before launching Cursor. Cloud Agents use Dashboard → Plugins & MCPs instead.
STITCH_GOOG_API_KEY=
