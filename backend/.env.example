APP_ENV=development
# Set to production on Railway; triggers JWT/CORS/storage/Postgres guards at API startup
SEED_DEMO_DATA=false
# Only true for local demos or dedicated staging — never on shared production

DATABASE_URL=postgresql+psycopg2://insightcase:insightcase@localhost:5432/insightcase
REDIS_URL=redis://localhost:6379/0
# Production (Railway): REDIS_URL=${{Redis.REDIS_URL}}, WEB_CONCURRENCY=3, DB_POOL_SIZE=10, DB_MAX_OVERFLOW=20
JWT_SECRET_KEY=change-me-in-production
JWT_REFRESH_SECRET_KEY=change-me-refresh-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# External integration API + remote MCP (read-only). Keep false in production until ready.
INTEGRATION_API_ENABLED=false
MCP_ENABLED=false
INTEGRATION_JWT_SECRET_KEY=your-integration-jwt-secret
INTEGRATION_ACCESS_TOKEN_MINUTES=15
INTEGRATION_DEFAULT_RATE_LIMIT_PER_MINUTE=60
INTEGRATION_MAX_PAGE_SIZE=50
INTEGRATION_CREDENTIAL_DEFAULT_TTL_DAYS=365
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# For Vercel previews, add each preview URL (comma-separated), e.g.:
# CORS_ORIGINS=http://localhost:5173,https://insightcase.vercel.app,https://insightcase-git-main-yourteam.vercel.app
FRONTEND_URL=http://localhost:5173
# Used in invite links, password reset emails, and booking notifications — must match your Vercel URL in production.

# Staff attendance — office geofence (clock-in) and monthly WFH quota (IST calendar month).
STAFF_OFFICE_LATITUDE=12.964118
STAFF_OFFICE_LONGITUDE=77.713036
STAFF_OFFICE_RADIUS_METERS=300
STAFF_OFFICE_LABEL=Insighte office (AECS Layout, Bengaluru)
STAFF_WFH_DAYS_PER_MONTH=15
STAFF_ATTENDANCE_WFH_COUNT_FROM=2026-10-06

# Optional: external policies clarification bot (support ticket pages)
POLICIES_BOT_URL=

# Transactional email (ZeptoMail SMTP recommended for production).
# When SMTP_HOST is unset, emails are logged only (safe for local dev).
EMAIL_PROVIDER=zeptomail
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@insighte.in
# Optional — leave unset to send all mail from SMTP_FROM_EMAIL (recommended for ZeptoMail).
# SMTP_FROM_BILLING_EMAIL=billing.noreply@insighte.in
# SMTP_FROM_VERIFICATION_EMAIL=verification.noreply@insighte.in
SMTP_FROM_NAME=Insighte
# Optional legacy full From header (overrides SMTP_FROM_EMAIL + SMTP_FROM_NAME when set):
# SMTP_FROM=Insighte <noreply@insighte.in>
SMTP_TLS=true
# Comma-separated admin inboxes for walk-in summaries and some scheduling alerts
ADMIN_NOTIFICATION_EMAILS=

# Password reset link lifetime (hours)
PASSWORD_RESET_EXPIRE_HOURS=1
# Max forgot-password requests per email per hour (abuse limit)
PASSWORD_RESET_RATE_LIMIT_PER_HOUR=3

# Named L1 owners for support ticket desks (Insighte production defaults).
TICKET_FINANCE_ASSIGNEE_EMAIL=chandrakiran@insighte.org
TICKET_HR_ASSIGNEE_EMAILS=sriparna.paul@insighte.org,pragya.dwivedi@insighte.org

# Report image storage (local dev default; use r2 in production)
STORAGE_PROVIDER=local
STORAGE_PREFIX=insightcase
STORAGE_ENVIRONMENT=development
MAX_UPLOAD_BYTES=10485760
# R2 (required when STORAGE_PROVIDER=r2 — bucket must stay private)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Billing / Finance (default off; staging may enable for verification)
# ENABLE_BILLING=false
# BILLING_LEDGER_WRITES=false
# FINANCE_CUTOVER_COMPLETE=false
# Session IEP evidence taps (default off; no registry writes)
# ENABLE_STRUCTURED_EVIDENCE=false
# Include Saturday/Sunday in default staff availability and session templates (default off)
# SCHEDULING_WEEKENDS_ENABLED=false
# Observation / IEP clinical report builders (default off; enable for testing/staging)
# ENABLE_CLINICAL_REPORTS_ENGINE=false
# Zoho Books seam (empty = sync not configured; never fake success)
# ZOHO_BOOKS_API_KEY=
