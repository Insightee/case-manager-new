{
  "name": "InsighteCase Dev",
  "install": "bash scripts/cloud-agent-install.sh",
  "terminals": [
    {
      "name": "backend-api",
      "command": "cd backend && python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8000"
    },
    {
      "name": "frontend-dev",
      "command": "cd frontend && npm run dev -- --host 0.0.0.0"
    }
  ],
  "ports": [
    { "name": "backend api", "port": 8000 },
    { "name": "frontend (vite)", "port": 5173 }
  ]
}
